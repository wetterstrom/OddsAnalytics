using OddsAnalytics.Models;

namespace OddsAnalytics.Services;

public interface IPredictionStrategy
{
    SportCategory Sport { get; }
    MatchProbabilities Calculate(Team home, Team away, LeagueConfig leagueConfig);
}

public abstract class PoissonPredictionStrategy : IPredictionStrategy
{
    protected abstract int MaxGoals { get; }
    protected abstract double OverUnderLine { get; }
    public abstract SportCategory Sport { get; }

    public MatchProbabilities Calculate(Team home, Team away, LeagueConfig leagueConfig)
    {
        ArgumentNullException.ThrowIfNull(home);
        ArgumentNullException.ThrowIfNull(away);
        ArgumentNullException.ThrowIfNull(leagueConfig);

        if (leagueConfig.HomeGoalsAvg <= 0 || leagueConfig.AwayGoalsAvg <= 0)
            throw new ArgumentException("League goal averages must be greater than zero.", nameof(leagueConfig));

        double homeAttack = home.HomeGoalsScoredAvg / leagueConfig.HomeGoalsAvg;
        double homeDefense = home.HomeGoalsConcededAvg / leagueConfig.AwayGoalsAvg;
        double awayAttack = away.AwayGoalsScoredAvg / leagueConfig.AwayGoalsAvg;
        double awayDefense = away.AwayGoalsConcededAvg / leagueConfig.HomeGoalsAvg;

        double lambdaHome = homeAttack * awayDefense * leagueConfig.HomeGoalsAvg;
        double lambdaAway = awayAttack * homeDefense * leagueConfig.AwayGoalsAvg;

        return PoissonEngine.CalculateMatchProbabilities(
            lambdaHome,
            lambdaAway,
            MaxGoals,
            OverUnderLine);
    }
}

public sealed class FootballPredictionStrategy : PoissonPredictionStrategy
{
    protected override int MaxGoals => 7;
    protected override double OverUnderLine => 2.5;
    public override SportCategory Sport => SportCategory.Football;
}

public sealed class HockeyPredictionStrategy : PoissonPredictionStrategy
{
    protected override int MaxGoals => 10;
    protected override double OverUnderLine => 5.5;
    public override SportCategory Sport => SportCategory.IceHockey;
}

public sealed class MatchAnalyzerService
{
    private readonly IReadOnlyDictionary<SportCategory, IPredictionStrategy> _strategies;

    public MatchAnalyzerService(IEnumerable<IPredictionStrategy> strategies)
    {
        ArgumentNullException.ThrowIfNull(strategies);
        _strategies = strategies.ToDictionary(strategy => strategy.Sport);
    }

    public MatchProbabilities Analyze(Team home, Team away, LeagueConfig leagueConfig)
    {
        ArgumentNullException.ThrowIfNull(leagueConfig);

        if (!_strategies.TryGetValue(leagueConfig.Sport, out var strategy))
            throw new NotSupportedException($"Sport '{leagueConfig.Sport}' is not supported.");

        return strategy.Calculate(home, away, leagueConfig);
    }
}
